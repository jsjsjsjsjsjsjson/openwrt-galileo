+/* Intel's Quark BSP masks the MSI vector and drains pending events before
+ * unmasking it. Use the PCI MSI API rather than private msi_desc fields.
+ */
+static irqreturn_t pch_udc_isr(int irq, void *pdev)
+{
+	struct pch_udc_dev *dev = pdev;
+	irqreturn_t handled = IRQ_NONE;
+	unsigned int pass;
+#ifdef CONFIG_PCI_MSI
+	struct irq_data *data = NULL;
+#endif
+
+	if (dev->pdev->vendor != PCI_VENDOR_ID_INTEL ||
+	    dev->pdev->device != PCI_DEVICE_ID_INTEL_QUARK_X1000_UDC)
+		return pch_udc_handle_interrupt(dev);
+
+#ifdef CONFIG_PCI_MSI
+	if (dev->pdev->msi_enabled) {
+		data = irq_get_irq_data(irq);
+		if (data && irq_data_get_msi_desc(data))
+			pci_msi_mask_irq(data);
+		else
+			data = NULL;
+	}
+#endif
+	/* Bound hard-IRQ work even if a device continually raises events. */
+	for (pass = 0; pass < 32; pass++) {
+		if (pch_udc_handle_interrupt(dev) == IRQ_NONE)
+			break;
+		handled = IRQ_HANDLED;
+	}
+#ifdef CONFIG_PCI_MSI
+	if (data)
+		pci_msi_unmask_irq(data);
+#endif
+	return handled;
+}
