diff --git a/drivers/mmc/host/sdhci-pci-core.c b/drivers/mmc/host/sdhci-pci-core.c
index 76ea0e8..cbaa432 100644
--- a/drivers/mmc/host/sdhci-pci-core.c
+++ b/drivers/mmc/host/sdhci-pci-core.c
@@ -1865,7 +1865,22 @@ static const struct sdhci_pci_fixes sdhci_amd = {
 	.probe_slot	= amd_probe_slot,
 };
 
+static int galileo_probe(struct sdhci_pci_chip *chip)
+{
+	if (dmi_match(DMI_BOARD_NAME, "GalileoGen2"))
+		chip->quirks2 |= SDHCI_QUIRK2_LED_ACTIVITY_ONLY;
+	return 0;
+}
+
+static const struct sdhci_pci_fixes sdhci_galileo = {
+	.probe = galileo_probe,
+};
+
 static const struct pci_device_id pci_ids[] = {
+	{
+		PCI_DEVICE(PCI_VENDOR_ID_INTEL, 0x08a7),
+		.driver_data = (kernel_ulong_t)&sdhci_galileo,
+	},
 	SDHCI_PCI_DEVICE(RICOH, R5C822,  ricoh),
 	SDHCI_PCI_DEVICE(RICOH, R5C843,  ricoh_mmc),
 	SDHCI_PCI_DEVICE(RICOH, R5CE822, ricoh_mmc),
diff --git a/drivers/mmc/host/sdhci.c b/drivers/mmc/host/sdhci.c
index 5c8a104..81c4f92 100644
--- a/drivers/mmc/host/sdhci.c
+++ b/drivers/mmc/host/sdhci.c
@@ -450,6 +450,8 @@ static int sdhci_led_register(struct sdhci_host *host)
 
 	if (host->quirks & SDHCI_QUIRK_NO_LED)
 		return 0;
+	if (host->quirks2 & SDHCI_QUIRK2_LED_ACTIVITY_ONLY)
+		return 0;
 
 	snprintf(host->led_name, sizeof(host->led_name),
 		 "%s::", mmc_hostname(mmc));
@@ -466,16 +468,22 @@ static void sdhci_led_unregister(struct sdhci_host *host)
 {
 	if (host->quirks & SDHCI_QUIRK_NO_LED)
 		return;
+	if (host->quirks2 & SDHCI_QUIRK2_LED_ACTIVITY_ONLY)
+		return;
 
 	led_classdev_unregister(&host->led);
 }
 
 static inline void sdhci_led_activate(struct sdhci_host *host)
 {
+	if (host->quirks2 & SDHCI_QUIRK2_LED_ACTIVITY_ONLY)
+		__sdhci_led_activate(host);
 }
 
 static inline void sdhci_led_deactivate(struct sdhci_host *host)
 {
+	if (host->quirks2 & SDHCI_QUIRK2_LED_ACTIVITY_ONLY)
+		__sdhci_led_deactivate(host);
 }
 
 #else
diff --git a/drivers/mmc/host/sdhci.h b/drivers/mmc/host/sdhci.h
index da1b0a4..52f6a0b 100644
--- a/drivers/mmc/host/sdhci.h
+++ b/drivers/mmc/host/sdhci.h
@@ -484,6 +484,8 @@ struct sdhci_host {
 #define SDHCI_QUIRK2_USE_32BIT_BLK_CNT			(1<<18)
 /* Issue CMD and DATA reset together */
 #define SDHCI_QUIRK2_ISSUE_CMD_DAT_RESET_TOGETHER	(1<<19)
+/* Keep the controller LED for I/O activity, without an LED class device. */
+#define SDHCI_QUIRK2_LED_ACTIVITY_ONLY		(1<<20)
 
 	int irq;		/* Device IRQ */
 	void __iomem *ioaddr;	/* Mapped address */
